# Clerk Authentication Publishable Key (optional; the app has a dev key built in).
# Uncomment only with a real key from https://dashboard.clerk.com, a placeholder breaks sign-in.
# VITE_CLERK_PUBLISHABLE_KEY=pk_test_...

# ---- LLM for JD Analytics (optional; the rule engine works without any) ----
# Pick ONE. Leave LLM_PROVIDER empty to auto-detect (first key found, else local Ollama).
LLM_PROVIDER=
# Free, cloud, fastest. Key: https://console.groq.com/keys
# Also used by the Resume Scanner (POST /api/resume/extract-skills).
GROQ_API_KEY=
# Resume Scanner model override (default openai/gpt-oss-120b)
GROQ_MODEL=
# Free tier, cloud. Key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Paid. Key: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Optional model override, e.g. openai/gpt-oss-20b (Groq), gemini-2.5-flash-lite (Gemini), qwen2.5:7b (Ollama)
LLM_MODEL=
